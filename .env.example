# Copy to .env (never commit .env). Used by docker-compose.yml and docker-compose.prod.yml.

# --- Database ---
POSTGRES_DB=studyabroad
POSTGRES_USER=studyabroad
# Dev default matches backend appsettings.json and advisor/.env.example. MUST be changed in production.
POSTGRES_PASSWORD=studyabroad

# --- AI ---
# Claude viết câu trả lời chat / giải thích / đọc bảng điểm (bước B). SLM local (usas-slm) chỉ phân loại.
ANTHROPIC_API_KEY=
# Mặc định claude-haiku-5-5 (xem advisor/app/core/config.py). Để trống = dùng mặc định.
ANTHROPIC_MODEL=
# Model dự phòng khi model chính quá tải/treo. Để trống = không dự phòng.
ANTHROPIC_FALLBACK_MODEL=
# Chỉ đặt model Ollama khi không có ANTHROPIC_API_KEY (transcript bước B chạy local). Có Claude thì để trống.
LLM_MODEL=
# GPU 6 GB (RTX 3050): num_gpu 99 = whole model on GPU; num_ctx 6144 keeps it inside VRAM.
# Raising LLM_NUM_CTX to 16384 makes Ollama fall back to CPU. Check with `ollama ps` (PROCESSOR = 100% GPU).
LLM_NUM_CTX=6144
LLM_NUM_GPU=99
EMBEDDING_MODEL=bge-m3
# Transcript OCR (step 2 of /analysis): vision model copies the image to text, text model extracts scores
VISION_MODEL=glm-ocr
# Chỉ dùng khi không có Claude key; để trống = reuse LLM_MODEL
TRANSCRIPT_PARSE_MODEL=
# Shared secret between the .NET API and the advisor service (openssl rand -hex 32)
ADVISOR_API_KEY=

# --- Authentication (JWT) ---
# Secret key for JWT signing (minimum 32 characters). Generated with: openssl rand -base64 32
JWT_SECRET_KEY=

# --- Email (SMTP - Real Sending) ---
# Required for sending real OTP emails (Registration, Unlock Account, Password Reset).
# If using Gmail, generate an App Password from your Google Account settings.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=USAS - Study Abroad Support
# Địa chỉ frontend dùng để dựng link trong mail (link mời phụ huynh). Production lấy https://$DOMAIN
APP_PUBLIC_URL=http://localhost:3000
# Backend chạy ngoài Docker (dotnet run/watch): dùng ./scripts/run-backend.ps1 (hoặc .sh) để nạp các biến SMTP_* từ file này.

# --- Seed (chỉ Development) ---
# Mật khẩu tài khoản admin@usas.edu.vn được tạo lần đầu. Để trống = không tạo admin.
SEED_ADMIN_PASSWORD=

# --- Production only ---
DOMAIN=example.com
CERTBOT_EMAIL=you@example.com
SWAGGER_ENABLED=false

