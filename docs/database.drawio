oToOne;startArrow=ERmany;endFill=0;startFill=0;strokeColor=#5b5b5b;strokeWidth=1.3;endSize=10;startSize=10;dashed=1;" edge="1" parent="1" source="r202" target="r231"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="r277" style="edgeStyle=entityRelationEdgeStyle;html=1;endArrow=ERzeroToOne;startArrow=ERmany;endFill=0;startFill=0;strokeColor=#5b5b5b;strokeWidth=1.3;endSize=10;startSize=10;dashed=1;" edge="1" parent="1" source="r214" target="r195"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="r278" style="edgeStyle=entityRelationEdgeStyle;html=1;endArrow=ERmandOne;startArrow=ERmany;endFill=0;startFill=0;strokeColor=#5b5b5b;strokeWidth=1.3;endSize=10;startSize=10;" edge="1" parent="1" source="r221" target="r197"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="r279" value="&lt;b&gt;3. Chat AI &amp;amp; kiến thức&lt;/b&gt;  &lt;span style=&#x27;font-size:14px;color:#666&#x27;&gt;Phiên chat, flow tư vấn, kho kiến thức, nhật ký gọi AI và bộ đánh giá&lt;/span&gt;" style="text;html=1;fontSize=22;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="0" y="2512" width="1650" height="40" as="geometry"/></mxCell><mxCell id="r280" value="&lt;b&gt;Cách đọc&lt;/b&gt;  &amp;#128273; khóa chính · &lt;b style=&#x27;color:#1f5fa8&#x27;&gt;FK&lt;/b&gt; khóa ngoại · &lt;b&gt;UQ&lt;/b&gt; không trùng · &lt;b&gt;?&lt;/b&gt; cho phép để trống&lt;br&gt;Đường nối đi từ cột khóa ngoại tới &lt;b&gt;id&lt;/b&gt; của bảng cha. Chạc ba = phía nhiều, gạch = một, vòng tròn = không bắt buộc. Nét đứt = khóa ngoại cho phép để trống.&lt;br&gt;&lt;span style=&#x27;color:#777&#x27;&gt;Bảng xám nét đứt&lt;/span&gt; là bảng thuộc phần khác, chỉ vẽ dòng id để nối. Rê chuột vào cột để xem mô tả." style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;rounded=1;fillColor=#f7f7f7;strokeColor=#cccccc;spacing=8;fontSize=11;" vertex="1" parent="1"><mxGeometry x="0" y="2560" width="1650" height="62" as="geometry"/></mxCell><UserObject label="&lt;b sty