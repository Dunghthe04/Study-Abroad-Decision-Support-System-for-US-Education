# Chạy advisor ngoài Docker: copy file này thành .env
OLLAMA_BASE_URL=http://localhost:11434
# Claude viết câu trả lời; usas-slm chỉ phân loại. Bắt buộc có key để chat/OCR bước B chạy cloud.
ANTHROPIC_API_KEY=
# Để trống = claude-haiku-5-5 (mặc định trong config)
ANTHROPIC_MODEL=
# Model Claude dự phòng khi model chính quá tải hoặc treo. Để trống = không có dự phòng
ANTHROPIC_FALLBACK_MODEL=
# Chỉ đặt model Ollama khi không có ANTHROPIC_API_KEY
LLM_MODEL=
LLM_TIMEOUT_SECONDS=120
# Đọc bảng điểm (bước 2 /analysis): model ảnh chép ảnh thành chữ, model chữ bóc điểm
VISION_MODEL=glm-ocr
# Chỉ dùng khi không có ANTHROPIC_API_KEY (có khóa thì bước đọc điểm chạy trên Claude). Để trống = dùng chung LLM_MODEL
TRANSCRIPT_PARSE_MODEL=
# Ghi mỗi lượt chat (đã che thông tin cá nhân) ra file, mỗi dòng một JSON. Để trống = không ghi file
CHAT_LOG_FILE=logs/chat.log
# Số ngày giữ file log chat, quá hạn thì tự xóa
CHAT_LOG_KEEP_DAYS=90
# Kho kiến thức (RAG) trên Postgres + pgvector. Để trống = tắt tính năng trả lời kiến thức. Chạy local: docker compose up db
DATABASE_URL=postgresql://studyabroad:studyabroad@localhost:5432/studyabroad
EMBEDDING_MODEL=bge-m3
# Trạng thái dòng kiến thức chat được dùng (cách nhau bằng dấu phẩy). Kho hiện còn draft: chạy thử local thì đặt verified,draft
KNOWLEDGE_STATUSES=verified,draft
# Độ tương đồng tối thiểu để trả lời; thấp hơn thì từ chối
KNOWLEDGE_MIN_SCORE=0.72
# Địa chỉ backend .NET: chat lấy trung tâm tư vấn (B6) qua API của backend. Để trống = tắt gợi ý trung tâm
BACKEND_BASE_URL=http://localhost:5080
