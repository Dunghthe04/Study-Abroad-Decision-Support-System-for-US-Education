"r360" style="edgeStyle=entityRelationEdgeStyle;html=1;endArrow=ERzeroToOne;startArrow=ERmany;endFill=0;startFill=0;strokeColor=#5b5b5b;strokeWidth=1.3;endSize=10;startSize=10;dashed=1;" edge="1" parent="1" source="r296" target="r327"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="r361" style="edgeStyle=entityRelationEdgeStyle;html=1;endArrow=ERzeroToOne;startArrow=ERmany;endFill=0;startFill=0;strokeColor=#5b5b5b;strokeWidth=1.3;endSize=10;startSize=10;dashed=1;" edge="1" parent="1" source="r303" target="r327"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="r362" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=ERzeroToOne;startArrow=ERmany;endFill=0;startFill=0;strokeColor=#5b5b5b;strokeWidth=1.3;endSize=10;startSize=10;dashed=1;exitX=1;exitY=0.5;entryX=1;entryY=0.5;" edge="1" parent="1" source="r304" target="r302"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="r363" style="edgeStyle=entityRelationEdgeStyle;html=1;endArrow=ERmandOne;startArrow=ERmany;endFill=0;startFill=0;strokeColor=#5b5b5b;strokeWidth=1.3;endSize=10;startSize=10;" edge="1" parent="1" source="r316" target="r327"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="r364" style="edgeStyle=entityRelationEdgeStyle;html=1;endArrow=ERmandOne;startArrow=ERmany;endFill=0;startFill=0;strokeColor=#5b5b5b;strokeWidth=1.3;endSize=10;startSize=10;" edge="1" parent="1" source="r317" target="r282"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="r365" style="edgeStyle=entityRelationEdgeStyle;html=1;endArrow=ERzeroToOne;startArrow=ERmany;endFill=0;startFill=0;strokeColor=#5b5b5b;strokeWidth=1.3;endSize=10;startSize=10;dashed=1;" edge="1" parent="1" source="r318" target="r340"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="r366" style="edgeStyle=entityRelationEdgeStyle;html=1;endArrow=ERmandOne;startArrow=ERmany;endFill=0;startFill=0;strokeColor=#5b5b5b;strokeWidth=1.3;endSize=10;startSize=10;" edge="1" parent="1" source="r330" target="r302"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="r367" style="edgeStyle=entityRelationEdgeStyle;html=1;endArrow=ERmandOne;startArrow=ERmany;endFill=0;startFill=0;strokeColor=#5b5b5b;strokeWidth=1.3;endSize=10;startSize=10;" edge="1" parent="1" source="r331" target="r327"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="r368" style="edgeStyle=entityRelationEdgeStyle;html=1;endArrow=ERzeroToOne;startArrow=ERmany;endFill=0;startFill=0;strokeColor=#5b5b5b;strokeWidth=1.3;endSize=10;startSize=10;dashed=1;" edge="1" parent="1" source="r335" target="r327"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="r369" value="&lt;b&gt;4. Trung tâm, diễn đàn, cấu hình&lt;/b&gt;  &lt;span style=&#x27;font-size:14px;color:#666&#x27;&gt;Trung tâm tư vấn, yêu cầu liên hệ, diễn đàn, lộ trình và cấu hình admin&lt;/span&gt;" style="text;html=1;fontSize=22;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="0" y="3746" width="1200" height="40" as="geometry"/></mxCell><mxCell id="r370" value="&lt;b&gt;Cách đọc&lt;/b&gt;  &amp;#128273; khóa chính · &lt;b style=&#x27;color:#1f5fa8&#x27;&gt;FK&lt;/b&gt; khóa ngoại · &lt;b&gt;UQ&lt;/b&gt; không trùng · &lt;b&gt;?&lt;/b&gt; cho phép để trống&lt;br&gt;Đường nối đi từ cột khóa ngoại tới &lt;b&gt;id&lt;/b&gt; của bảng cha. Chạc ba = phía nhiều, gạch = một, vòng tròn = không bắt buộc. Nét đứt = khóa ngoại cho phép để trống.&lt;br&gt;&lt;span style=&#x27;color:#777&#x27;&gt;Bảng xám nét đứt&lt;/span&gt; là bảng thuộc phần khác, chỉ vẽ dòng id để nối. Rê chuột vào cột để xem mô tả." style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;rounded=1;fillColor=#f7f7f7;strokeColor=#cccccc;spacing=8;fontSize=11;" vertex="1" parent="1"><mxGeometry x="0" y="3794" width="1200" height="62" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>
