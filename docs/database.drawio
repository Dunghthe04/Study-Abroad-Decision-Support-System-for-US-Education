cccc;spacing=8;fontSize=11;" vertex="1" parent="1"><mxGeometry x="40" y="-140" width="820" height="64" as="geometry"/></mxCell><mxCell id="w400" value="Hồ sơ học sinh" style="text;html=1;fontSize=13;fontStyle=1;fontColor=#1f4e79;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="-36" width="210" height="24" as="geometry"/></mxCell><mxCell id="w401" value="Tài khoản" style="text;html=1;fontSize=13;fontStyle=1;fontColor=#1f4e79;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="560" y="-36" width="170" height="24" as="geometry"/></mxCell><mxCell id="w402" value="Trung tâm &amp; diễn đàn" style="text;html=1;fontSize=13;fontStyle=1;fontColor=#1f4e79;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="820" y="-36" width="220" height="24" as="geometry"/></mxCell><mxCell id="w403" value="Thông báo, chat &amp; tri thức" style="text;html=1;fontSize=13;fontStyle=1;fontColor=#1f4e79;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1080" y="-36" width="260" height="24" as="geometry"/></mxCell><mxCell id="w404" value="Trường &amp; học bổng" style="text;html=1;fontSize=13;fontStyle=1;fontColor=#1f4e79;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1670" y="514" width="250" height="24" as="geometry"/></mxCell><mxCell id="w405" value="Danh mục &amp; vận hành" style="text;html=1;fontSize=13;fontStyle=1;fontColor=#1f4e79;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="1424" width="280" height="24" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>
