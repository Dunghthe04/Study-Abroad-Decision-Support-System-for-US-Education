# Chạy advisor ngoài Docker: copy file này thành .env
OLLAMA_BASE_URL=http://localhost:11434
LLM_MODEL=qwen3:8b
LLM_TIMEOUT_SECONDS=120
# Đọc bảng điểm (bước 2 /analysis): model ảnh chép ảnh thành chữ, model chữ bóc điểm
VISION_MODEL=glm-ocr
# Để trống = dùng chung LLM_MODEL. GPU < 8 GB hoặc máy chỉ có CPU: đặt qwen3:4b (nhanh gấp đôi) rồi `ollama pull qwen3:4b`
TRANSCRIPT_PARSE_MODEL=