# Production reverse proxy. ${DOMAIN} is substituted by the nginx image at startup.

limit_req_zone $binary_remote_addr zone=advisor:10m rate=10r/m;
# Các API xác thực (đăng nhập, đăng ký, OTP, quên/đổi mật khẩu): chống dò mật khẩu/OTP và spam mail theo IP
limit_req_zone $binary_remote_addr zone=auth:10m rate=20r/m;

upstream web_upstream { server web:3000; }
upstream api_upstream { server api:8080; }

server {
    listen 80;
    server_name ${DOMAIN} www.${DOMAIN};

    location /.well-known/acme-challenge/ { root /var/www/certbot; }
    location / { return 301 https://$host$request_uri; }
}

server {
    listen 443 ssl;
    http2 on;
    server_name ${DOMAIN} www.${DOMAIN};

    ssl_certificate     /etc/letsencrypt/live/${DOMAIN}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/${DOMAIN}/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_session_cache shared:SSL:10m;

    # Header bảo mật (CSP, HSTS, X-Frame-Options, nosniff, Referrer-Policy, Permissions-Policy) do ứng dụng tự gắn:
    # trang web ở frontend/next.config.ts, API ở SecurityHeadersMiddleware. Bản Azure không qua Nginx nên không đặt ở đây.

    client_max_body_size 10m;
    gzip on;
    gzip_types text/plain text/css application/json application/javascript image/svg+xml;

    include /etc/nginx/snippets/locations.conf;
}
