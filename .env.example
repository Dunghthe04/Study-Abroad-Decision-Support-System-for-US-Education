# Copy to .env (never commit .env). Used by docker-compose.yml and docker-compose.prod.yml.

# --- Database ---
POSTGRES_DB=studyabroad
POSTGRES_USER=studyabroad
# Dev default matches backend appsettings.json and advisor/.env.example. MUST be changed in production.
POSTGRES_PASSWORD=studyabroad

# --- AI ---
# Dev: qwen3:8b ; Prod (VPS): qwen3:14b
LLM_MODEL=qwen3:8b
EMBEDDING_MODEL=bge-m3
# Shared secret between the .NET API and the advisor service (openssl rand -hex 32)
ADVISOR_API_KEY=

# --- Production only ---
DOMAIN=example.com
CERTBOT_EMAIL=you@example.com
SWAGGER_ENABLED=false
