{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Debug",
      "Override": {
        "Microsoft.AspNetCore": "Information"
      }
    }
  },
  "PayOs": {
    "UseFake": true,
    "ChecksumKey": "dev-checksum-key"
  },
  "Smtp": {
    "Host": "smtp.gmail.com",
    "Port": 587,
    "FromName": "USAS - Study Abroad Support",
    "EnableSsl": true,
    "AppBaseUrl": "http://localhost:3000"
  },
  "Features": {
    "AllowChatImageUpload": true
  },
  "Cloudinary": {
    "Folder": "usas",
    "MaxFileSizeBytes": 10485760,
    "MaxImagePixels": 25000000
  }
}
